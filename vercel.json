{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'no dependencies'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^de(?:[-_][A-Za-z0-9]+)?(?:[,;].*)?$"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^nl(?:[-_][A-Za-z0-9]+)?(?:[,;].*)?$"
        }
      ],
      "destination": "/nl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^es(?:[-_][A-Za-z0-9]+)?(?:[,;].*)?$"
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^hr(?:[-_][A-Za-z0-9]+)?(?:[,;].*)?$"
        }
      ],
      "destination": "/hr/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/kits",
      "destination": "/en/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/kits/",
      "destination": "/en/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/en/kits",
      "destination": "/en/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/en/kits/",
      "destination": "/en/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/de/kits",
      "destination": "/de/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/de/kits/",
      "destination": "/de/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/nl/kits",
      "destination": "/nl/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/nl/kits/",
      "destination": "/nl/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/es/kits",
      "destination": "/es/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/es/kits/",
      "destination": "/es/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/hr/kits",
      "destination": "/hr/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/hr/kits/",
      "destination": "/hr/eu-compliance-kits/",
      "permanent": false
    },
    {
      "source": "/:lang/:section/:slug(studio-rosalie|mustermann-sanitaer|kfz-werkstatt)",
      "destination": "/:lang/:section/",
      "permanent": true
    }
  ]
}
